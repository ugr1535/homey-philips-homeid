    },
    "getBrewMenu": {
      "method": "GET",
      "path": "/brew-menu/:deviceId"
    },
    "setPower": {
      "method": "POST",
      "path": "/power/:deviceId"
    },
    "brewSaved": {
      "method": "POST",
      "path": "/brew-saved/:deviceId"
    }
  }
}
